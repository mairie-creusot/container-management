# Variables du déploiement de production (docker-compose.prod.yml).
# Copier en .env.prod et renseigner les VRAIES valeurs — ce fichier d'exemple n'en contient aucune.
#
#   docker compose -f deploy/compose/docker-compose.prod.yml --env-file deploy/compose/.env.prod up -d --build
#
# .env.prod contient des secrets : ne jamais le committer.

# URL par laquelle les navigateurs joignent QUAI (sert d'origine CORS et de lien de retour dans
# les tickets GLPI créés automatiquement).
QUAI_PUBLIC_URL=https://quai.lecreusot.priv

# Port publié sur l'hôte pour l'interface (le conteneur web écoute sur 8080).
QUAI_HTTP_PORT=8080

# Signature des sessions. Générer une valeur unique : openssl rand -hex 32
JWT_SECRET=

# Laisser true dès que QUAI est servi en HTTPS. false uniquement pour un accès en HTTP simple,
# sinon le navigateur refuse le cookie de session et la connexion échoue silencieusement.
COOKIE_SECURE=true

# Chiffre config.json (identifiants Nutanix, HYCU, GLPI, 3CX, ExaGrid...). Générer une fois :
# openssl rand -hex 32 — et la SAUVEGARDER : sans elle, ces configurations sont irrécupérables.
CONFIG_ENCRYPTION_KEY=

# --- Active Directory RÉEL (aucun annuaire de test en production) ----------------------------
# ldaps:// recommandé (chiffré). Un contrôleur de domaine sur son certificat interne exige que ce
# certificat soit approuvé par le conteneur ; à défaut, ldap:// sur un réseau de confiance.
LDAP_URL=ldaps://dc01.lecreusot.priv:636

# Compte de service en LECTURE SEULE sur l'annuaire (jamais un compte administrateur).
LDAP_BIND_DN=CN=svc-quai,OU=Services,OU=ville-du-Creusot,DC=lecreusot,DC=priv
LDAP_BIND_PASSWORD=

# Racine de recherche : doit couvrir TOUTES les OU contenant des utilisateurs autorisés
# (une OU oubliée = « identifiants invalides » pour ces comptes, sans autre explication).
LDAP_SEARCH_BASE=OU=ville-du-Creusot,DC=lecreusot,DC=priv

# {{username}} est remplacé par ce que saisit l'utilisateur. En Active Directory, sAMAccountName
# correspond à l'identifiant de session habituel ; ajouter userPrincipalName accepte aussi la
# forme prenom.nom@domaine.
LDAP_SEARCH_FILTER=(&(objectClass=user)(|(sAMAccountName={{username}})(userPrincipalName={{username}})))

# Association groupe (ou OU) -> rôle QUAI. La clé peut être le DN exact d'un groupe de sécurité,
# ou une OU présente dans le DN de l'utilisateur (voir services/ldap.ts#mapGroupsToRoles).
LDAP_GROUP_ROLE_MAP={"CN=QUAI-Admins,OU=Groupes,DC=lecreusot,DC=priv":"admin","CN=QUAI-Operateurs,OU=Groupes,DC=lecreusot,DC=priv":"operator"}

# Rôle attribué à un utilisateur authentifié ne correspondant à aucune entrée ci-dessus.
LDAP_DEFAULT_ROLE=viewer
