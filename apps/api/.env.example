# QUAI API — variables d'environnement
# Copier ce fichier en .env pour le développement local.
# Aucune valeur secrète ne doit être commit — ce fichier ne contient que des exemples/valeurs par défaut.

# --- Serveur ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Origine(s) autorisée(s) pour le CORS côté apps/web (séparées par des virgules), "*" en dev si besoin.
CORS_ORIGIN=http://localhost:5173

# --- Session / JWT ---
# Secret utilisé pour signer les JWT de session. À générer aléatoirement en production
# (ex: `openssl rand -hex 32`). La valeur ci-dessous n'est qu'un défaut de développement.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=quai_session
# true en production (HTTPS obligatoire), false en dev http local.
COOKIE_SECURE=false

# --- LDAP ---
# URL du serveur LDAP/LDAPS de l'annuaire (ex: ldap://ldap.lecreusot.fr:389).
LDAP_URL=ldap://localhost:389
# DN technique utilisé pour le bind de recherche (avant le bind de l'utilisateur).
LDAP_BIND_DN=cn=admin,dc=lecreusot,dc=fr
LDAP_BIND_PASSWORD=admin
# Base de recherche des comptes utilisateurs.
LDAP_SEARCH_BASE=ou=people,dc=lecreusot,dc=fr
# Filtre de recherche, {{username}} est remplacé par le login saisi.
LDAP_SEARCH_FILTER=(uid={{username}})
# Mapping JSON des groupes LDAP (DN complet) vers les rôles applicatifs (admin | operator | viewer).
LDAP_GROUP_ROLE_MAP={"cn=dsi-admins,ou=groupes,dc=lecreusot,dc=fr":"admin","cn=dsi-operateurs,ou=groupes,dc=lecreusot,dc=fr":"operator","cn=dsi-lecture,ou=groupes,dc=lecreusot,dc=fr":"viewer"}
# Rôle attribué si l'utilisateur est authentifié mais n'appartient à aucun groupe mappé.
LDAP_DEFAULT_ROLE=viewer

# --- Docker / Swarm ---
# Optionnel : hôte du démon Docker (ex: tcp://localhost:2375, npipe:////./pipe/docker_engine sous Windows,
# unix:///var/run/docker.sock sous Linux/Mac). Si absent, dockerode tente le socket par défaut de l'OS.
# En cas d'échec de connexion, l'API bascule automatiquement sur un jeu de données de démonstration.
DOCKER_HOST=

# --- Kubernetes ---
# Optionnel : chemin vers un kubeconfig. Si absent ou invalide, bascule sur les données de démonstration.
KUBECONFIG=

# --- Nutanix ---
# Pas de bootstrap par variable d'environnement : l'URL Prism Central + les identifiants se
# saisissent toujours via l'assistant de configuration (mot de passe chiffré au repos comme
# le mot de passe LDAP et le kubeconfig). Seuls ces deux réglages de connexion sont globaux :
# false si Prism Central présente un certificat auto-signé (cas fréquent en on-prem, valeur
# par défaut) ; true si son certificat est signé par une CA de confiance.
NUTANIX_TLS_REJECT_UNAUTHORIZED=false
# Timeout (ms) appliqué aux appels vers l'API REST v3 de Prism Central.
NUTANIX_REQUEST_TIMEOUT_MS=8000

# --- Registries ---
# Timeout (ms) appliqué aux appels vers les API publiques des registries.
REGISTRY_REQUEST_TIMEOUT_MS=5000
# Identifiants optionnels pour augmenter les quotas / accéder à des dépôts privés.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
GHCR_TOKEN=
GITLAB_TOKEN=

# --- Assistant de configuration (premier lancement) ---
# Fichier JSON persistant l'état de l'assistant (completed + config LDAP/Docker/K8s/registries
# saisie). Défaut dev : fichier local ; en conteneur, pointer vers un volume monté
# (ex: /data/quai/config.json). Tant qu'il n'existe pas, les variables LDAP_*/DOCKER_HOST
# ci-dessus ne font que pré-remplir l'assistant (voir ARCHITECTURE.md).
CONFIG_PATH=./data/config.json

# Clé de chiffrement (AES-256-GCM) des secrets persistés dans CONFIG_PATH (mot de passe LDAP,
# kubeconfig, jetons de registry) — 64 caractères hex (32 octets). À générer avec :
#   openssl rand -hex 32
# OBLIGATOIRE en production (NODE_ENV=production) : l'API refuse de démarrer sans elle dès
# qu'un secret doit être persisté. En développement, son absence n'est pas bloquante mais une
# clé aléatoire éphémère est utilisée à la place — les secrets sauvegardés ne survivent alors
# pas à un redémarrage. Ne jamais commit une vraie valeur ici.
CONFIG_ENCRYPTION_KEY=

# --- Modules distribuables (greffons installés à chaud) ---
# Répertoire d'installation des modules signés. Non défini = sous-dossier `plugins/` du répertoire
# de CONFIG_PATH (même convention que audit-log.jsonl) : les modules vivent avec les DONNÉES, pas
# dans le code livré — un module installé survit à une reconstruction d'image, un module
# désinstallé disparaît réellement.
PLUGINS_PATH=
# Clés PUBLIQUES autorisées à signer un module — JSON { "<identifiant de clé>": "<clé publique>" },
# clé publique Ed25519 en DER SPKI base64 (ce que produit `node scripts/sign-plugin.mjs keygen`),
# en 32 octets bruts base64, ou en PEM.
#   node scripts/sign-plugin.mjs keygen --out ./quai-signing --key-id mairie-2026
# La signature est la SEULE frontière de sécurité : un module installé s'exécute DANS le process de
# l'API, qui a accès au socket Docker, aux identifiants Active Directory et à la clé de chiffrement
# des configurations. N'y mettez que des clés dont vous contrôlez la clé privée, et gardez cette
# clé privée HORS du serveur (l'outil de signature s'utilise sur le poste de l'éditeur du module).
# Vide = l'installation de modules externes est indisponible ; les greffons livrés avec l'image
# continuent de fonctionner normalement.
PLUGIN_TRUSTED_KEYS=
# AUTORITÉS habilitées à délivrer un certificat de signature de module — l'AD CS de la collectivité.
# Certificat racine en PEM (base64 accepté, pour traverser sans dommage une variable de CI), ou par
# fichier avec PLUGIN_TRUSTED_CA_FILE. C'est alors l'autorité qui répond de ses porteurs : le serveur
# n'a aucune clé de signataire à connaître, le paquet dit QUI l'a signé, et retirer ce droit se fait
# côté autorité — ou ici, avec PLUGIN_REVOKED_CERTS.
# Un certificat n'est accepté que s'il porte l'usage « signature de code » (1.3.6.1.5.5.7.3.3), qu'il
# est valide à cet instant, et qu'il remonte réellement à l'une de ces autorités.
# VOLONTAIREMENT DISTINCT de NODE_EXTRA_CA_CERTS : faire confiance à une autorité pour valider le
# certificat d'un serveur HTTPS n'est pas lui donner le droit d'habiliter du code qui s'exécutera
# dans ce processus. Les deux peuvent désigner la même autorité, mais ce doit être écrit.
#   node scripts/sign-plugin.mjs sign ./mon-module --key ./signataire.key --cert ./signataire.pem
PLUGIN_TRUSTED_CA=
PLUGIN_TRUSTED_CA_FILE=
# Certificats de signature RETIRÉS, par empreinte SHA-256 (celle qu'affichent certutil et la console
# AD CS), séparées par des virgules ou des espaces. QUAI ne consulte NI liste de révocation NI OCSP :
# ce serait un appel réseau au moment même où il décide de charger du code, et son échec n'aurait
# aucune réponse honnête. Un module signé par un certificat listé ici cesse d'être chargé au cycle
# suivant, sans reconstruction d'image.
PLUGIN_REVOKED_CERTS=
# --- Listes de révocation (CRL) de l'autorité ---
# Répertoire où QUAI LIT les listes de révocation. Non défini = sous-dossier `crl/` du répertoire de
# CONFIG_PATH. La vérification n'y fait AUCUN appel réseau : interroger une PKI au moment précis où
# le socle décide de charger du code n'aurait pas de réponse honnête en cas d'échec — ni « je charge
# quand même », ni « je coupe tout ». Une liste absente ou périmée se voit sur l'écran des Modules.
PLUGIN_CRL_PATH=
# Ce qu'on fait d'un certificat qu'aucune liste à jour ne couvre :
#   off    — les listes ne sont pas consultées.
#   soft   — (défaut) un certificat listé comme révoqué est refusé ; une liste absente ou périmée ne
#            bloque rien. Sans liste déposée, le comportement est identique à « off ».
#   strict — un certificat qu'aucune liste à jour ne couvre est refusé lui aussi. À choisir quand la
#            PKI publie réellement ses listes : la publication devient alors indispensable au
#            chargement des modules, ce qui est le but et doit rester un choix explicite.
PLUGIN_CRL_POLICY=soft
# URLs des listes à rapatrier périodiquement (séparées par des virgules). VIDE = QUAI n'émet aucun
# appel : seuls les fichiers déposés à la main dans PLUGIN_CRL_PATH comptent. C'est la SEULE partie
# du dispositif qui touche au réseau, et elle tourne à part (services/crlRefresher.ts).
#   http://pki.lecreusot.priv/CertEnroll/lecreusot-HDVAD1-CA-ROOT.crl
PLUGIN_CRL_URLS=
# Intervalle de rapatriement, en millisecondes (défaut 6 h, minimum 1 min).
PLUGIN_CRL_REFRESH_MS=21600000
# Répertoire des paquets d'ORIGINE : les intégrations livrées avec QUAI (3cx, glpi, hycu, nutanix),
# empaquetées et signées PENDANT la construction de l'image avec une paire de clés générée pour ce
# seul build, dont la clé privée n'est jamais écrite. Elles sont installées au premier démarrage dans
# PLUGINS_PATH puis se comportent comme n'importe quel module : désactivables, désinstallables (le
# retrait est mémorisé et survit au redémarrage), restaurables depuis l'image.
# Positionné par deploy/docker/Dockerfile.api (/app/origin-plugins). VIDE HORS IMAGE — `pnpm dev`,
# `vitest` : le socle retombe alors sur son catalogue interne importé statiquement
# (apps/api/src/plugins/builtins.ts), sinon aucune intégration ne serait disponible en local.
PLUGIN_ORIGIN_PATH=
# Clé PUBLIQUE d'origine. Normalement lue dans le fichier `origin-key.pub` de PLUGIN_ORIGIN_PATH :
# cette variable n'existe que pour la fournir directement (tests). Elle ne peut pas être remplacée
# par une entrée de PLUGIN_TRUSTED_KEYS, et n'ouvre aucune porte — sa clé privée n'existe plus.
PLUGIN_ORIGIN_KEY=
# Taille maximale (octets) d'un paquet accepté à l'installation, une fois décodé.
PLUGIN_MAX_PACKAGE_BYTES=2097152
# Délais d'expiration (ms) des appels AUX greffons. Sans isolation hors processus, un greffon qui ne
# rend jamais la main figerait le graphe entier : un appel dépassé est abandonné, tracé, et le
# greffon traité comme non contributif.
PLUGIN_TEST_TIMEOUT_MS=15000
PLUGIN_GRAPH_TIMEOUT_MS=10000
PLUGIN_SNAPSHOT_TIMEOUT_MS=10000
PLUGIN_ACTION_TIMEOUT_MS=30000

# --- Reverse proxy interne (*.lecreusot.priv) ---
# Fichier JSON persistant les routes du reverse proxy interne (même pattern que SECRETS_PATH).
REVERSE_PROXY_PATH=./data/reverse-proxy.json
# URL de l'API d'administration JSON de Caddy (https://caddyserver.com/docs/api), jointe par son
# nom de service docker-compose — jamais exposée à l'hôte (voir deploy/compose/docker-compose.dev.yml).
CADDY_ADMIN_URL=http://caddy:2019
# Timeout (ms) appliqué aux appels vers l'API d'administration Caddy.
CADDY_REQUEST_TIMEOUT_MS=5000
# Intervalle (ms) de la boucle de réconciliation : la config de Caddy ne vit qu'en mémoire et est
# perdue à chaque redémarrage de Caddy — QUAI la republie au démarrage puis dès qu'une dérive
# réelle est constatée (comparaison avec ce que Caddy sert vraiment, jamais un push à l'aveugle).
REVERSE_PROXY_RECONCILE_INTERVAL_MS=60000

# --- Certificats TLS (autorité AD CS interne) ---
# L'URL de l'autorité, le modèle de certificat et le compte de service ne sont PAS des variables
# d'environnement : ils se configurent dans l'interface (PUT /api/certificates/config) et sont
# persistés chiffrés au repos dans config.json, comme HYCU/Nutanix.
# Fichier JSON persistant les certificats émis (clé privée chiffrée au repos, fichier 0600).
CERTIFICATES_PATH=./data/certificates.json
# Timeout (ms) appliqué aux appels vers le site d'inscription web AD CS (certsrv).
CERTIFICATES_REQUEST_TIMEOUT_MS=15000
# Marge de renouvellement par défaut (jours avant expiration) — surchargeable par la configuration.
CERTIFICATES_RENEW_BEFORE_DAYS=30
# Intervalle (ms) de la boucle de renouvellement (défaut 6 h : un certificat AD CS vit des mois).
CERTIFICATES_RECONCILE_INTERVAL_MS=21600000
# L'autorité présente un certificat qu'elle a elle-même émis, inconnu du conteneur tant que sa
# racine n'y est pas installée — mettre à true une fois la racine AD CS approuvée par le conteneur.
CERTIFICATES_TLS_REJECT_UNAUTHORIZED=false

# --- GitOps ---
# Dossier local contenant les manifestes YAML (état désiré). Cloné/pull automatiquement si GITOPS_REPO_URL est défini.
GITOPS_REPO_PATH=./data/gitops
# Optionnel : URL du dépôt Git GitOps distant (https://... ou git@...).
GITOPS_REPO_URL=
GITOPS_BRANCH=main
# Identifiants optionnels pour l'accès au dépôt distant (HTTPS + token).
GITOPS_GIT_USERNAME=
GITOPS_GIT_TOKEN=

# --- GLPI (tickets) : la connexion elle-même se configure dans l'interface, chiffrée au repos. ---
GLPI_REQUEST_TIMEOUT_MS=8000
# URL publique de QUAI, utilisée uniquement pour le lien de retour placé dans un ticket créé
# automatiquement — omise du ticket si vide (jamais d'URL fabriquée).
QUAI_PUBLIC_URL=

# --- PBX 3CX (XAPI) : URL, client_id et clé API se configurent dans l'interface, chiffrés au repos. ---
# Un 3CX on-prem est publié sous son FQDN 3CX avec un certificat valide : vérification TLS activée
# par défaut. Le drapeau saisi dans l'interface prime sur cette valeur.
THREECX_TLS_REJECT_UNAUTHORIZED=true
THREECX_REQUEST_TIMEOUT_MS=8000
# Durée de mise en cache de l'annuaire des postes (résolution des noms sur les appels en cours) :
# le XAPI n'accepte qu'un seul jeton actif par instance, on évite de le solliciter inutilement.
THREECX_DIRECTORY_CACHE_MS=60000
