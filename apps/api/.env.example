# QUAI API — variables d'environnement
# Copier ce fichier en .env pour le développement local.
# Aucune valeur secrète ne doit être commit — ce fichier ne contient que des exemples/valeurs par défaut.

# --- Serveur ---
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Origine(s) autorisée(s) pour le CORS côté apps/web (séparées par des virgules), "*" en dev si besoin.
CORS_ORIGIN=http://localhost:5173

# --- Session / JWT ---
# Secret utilisé pour signer les JWT de session. À générer aléatoirement en production
# (ex: `openssl rand -hex 32`). La valeur ci-dessous n'est qu'un défaut de développement.
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_NAME=quai_session
# true en production (HTTPS obligatoire), false en dev http local.
COOKIE_SECURE=false

# --- LDAP ---
# URL du serveur LDAP/LDAPS de l'annuaire (ex: ldap://ldap.lecreusot.fr:389).
LDAP_URL=ldap://localhost:389
# DN technique utilisé pour le bind de recherche (avant le bind de l'utilisateur).
LDAP_BIND_DN=cn=admin,dc=lecreusot,dc=fr
LDAP_BIND_PASSWORD=admin
# Base de recherche des comptes utilisateurs.
LDAP_SEARCH_BASE=ou=people,dc=lecreusot,dc=fr
# Filtre de recherche, {{username}} est remplacé par le login saisi.
LDAP_SEARCH_FILTER=(uid={{username}})
# Mapping JSON des groupes LDAP (DN complet) vers les rôles applicatifs (admin | operator | viewer).
LDAP_GROUP_ROLE_MAP={"cn=dsi-admins,ou=groupes,dc=lecreusot,dc=fr":"admin","cn=dsi-operateurs,ou=groupes,dc=lecreusot,dc=fr":"operator","cn=dsi-lecture,ou=groupes,dc=lecreusot,dc=fr":"viewer"}
# Rôle attribué si l'utilisateur est authentifié mais n'appartient à aucun groupe mappé.
LDAP_DEFAULT_ROLE=viewer

# --- Docker / Swarm ---
# Optionnel : hôte du démon Docker (ex: tcp://localhost:2375, npipe:////./pipe/docker_engine sous Windows,
# unix:///var/run/docker.sock sous Linux/Mac). Si absent, dockerode tente le socket par défaut de l'OS.
# En cas d'échec de connexion, l'API bascule automatiquement sur un jeu de données de démonstration.
DOCKER_HOST=

# --- Kubernetes ---
# Optionnel : chemin vers un kubeconfig. Si absent ou invalide, bascule sur les données de démonstration.
KUBECONFIG=

# --- Nutanix ---
# Pas de bootstrap par variable d'environnement : l'URL Prism Central + les identifiants se
# saisissent toujours via l'assistant de configuration (mot de passe chiffré au repos comme
# le mot de passe LDAP et le kubeconfig). Seuls ces deux réglages de connexion sont globaux :
# false si Prism Central présente un certificat auto-signé (cas fréquent en on-prem, valeur
# par défaut) ; true si son certificat est signé par une CA de confiance.
NUTANIX_TLS_REJECT_UNAUTHORIZED=false
# Timeout (ms) appliqué aux appels vers l'API REST v3 de Prism Central.
NUTANIX_REQUEST_TIMEOUT_MS=8000

# --- Registries ---
# Timeout (ms) appliqué aux appels vers les API publiques des registries.
REGISTRY_REQUEST_TIMEOUT_MS=5000
# Identifiants optionnels pour augmenter les quotas / accéder à des dépôts privés.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
GHCR_TOKEN=
GITLAB_TOKEN=

# --- Assistant de configuration (premier lancement) ---
# Fichier JSON persistant l'état de l'assistant (completed + config LDAP/Docker/K8s/registries
# saisie). Défaut dev : fichier local ; en conteneur, pointer vers un volume monté
# (ex: /data/quai/config.json). Tant qu'il n'existe pas, les variables LDAP_*/DOCKER_HOST
# ci-dessus ne font que pré-remplir l'assistant (voir ARCHITECTURE.md).
CONFIG_PATH=./data/config.json

# Clé de chiffrement (AES-256-GCM) des secrets persistés dans CONFIG_PATH (mot de passe LDAP,
# kubeconfig, jetons de registry) — 64 caractères hex (32 octets). À générer avec :
#   openssl rand -hex 32
# OBLIGATOIRE en production (NODE_ENV=production) : l'API refuse de démarrer sans elle dès
# qu'un secret doit être persisté. En développement, son absence n'est pas bloquante mais une
# clé aléatoire éphémère est utilisée à la place — les secrets sauvegardés ne survivent alors
# pas à un redémarrage. Ne jamais commit une vraie valeur ici.
CONFIG_ENCRYPTION_KEY=

# --- Reverse proxy interne (*.lecreusot.priv) ---
# Fichier JSON persistant les routes du reverse proxy interne (même pattern que SECRETS_PATH).
REVERSE_PROXY_PATH=./data/reverse-proxy.json
# URL de l'API d'administration JSON de Caddy (https://caddyserver.com/docs/api), jointe par son
# nom de service docker-compose — jamais exposée à l'hôte (voir deploy/compose/docker-compose.dev.yml).
CADDY_ADMIN_URL=http://caddy:2019
# Timeout (ms) appliqué aux appels vers l'API d'administration Caddy.
CADDY_REQUEST_TIMEOUT_MS=5000

# --- GitOps ---
# Dossier local contenant les manifestes YAML (état désiré). Cloné/pull automatiquement si GITOPS_REPO_URL est défini.
GITOPS_REPO_PATH=./data/gitops
# Optionnel : URL du dépôt Git GitOps distant (https://... ou git@...).
GITOPS_REPO_URL=
GITOPS_BRANCH=main
# Identifiants optionnels pour l'accès au dépôt distant (HTTPS + token).
GITOPS_GIT_USERNAME=
GITOPS_GIT_TOKEN=
