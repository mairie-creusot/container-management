# syntax=docker/dockerfile:1
#
# Image de DÉVELOPPEMENT pour @quai/api — PAS l'image de production (voir Dockerfile.api).
# Code applicatif bind-monté depuis l'hôte (docker-compose.dev.yml), donc pas de COPY/build
# ici : ce Dockerfile installe uniquement les outils système dont l'API a besoin à l'exécution
# (git pour GitOps, OpenTofu/Ansible/Packer pour l'intégration infra-as-code — voir
# apps/api/src/services/iac/*) sur node:22-slim, une fois pour toutes via le cache de layers
# Docker plutôt que réinstallés à chaque démarrage de conteneur (c'était le cas avant, via une
# commande shell inline dans docker-compose.dev.yml — lent et fragile).
#
# Reconstruire après modification : docker compose -f deploy/compose/docker-compose.dev.yml build api

FROM node:22-slim

ARG TARGETARCH

# krb5-user pose une question debconf ("royaume Kerberos par défaut") lors de son installation —
# sans frontend non-interactif explicite, `docker build` peut rester bloqué en attente d'une
# réponse. Sans incidence sur QUAI : services/adDns.ts fournit toujours son propre krb5.conf
# temporaire par appel (KRB5_CONFIG), le royaume par défaut laissé vide ici n'est jamais utilisé.
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git \
        curl \
        ca-certificates \
        unzip \
        python3 \
        python3-pip \
        openssh-client \
        gnupg \
        krb5-user \
        dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Ansible : paquet Debian trop ancien pour les modules récents — installé via pip, dans un
# environnement dédié (--break-system-packages requis sur Debian 12+ qui protège le python
# système par défaut ; sans risque ici, l'image ne sert qu'au conteneur dev).
RUN pip3 install --no-cache-dir --break-system-packages ansible-core

# mkosi (systemd/mkosi) : moteur "OS minimal from-scratch" des templates d'images — paquet Debian
# bookworm trop ancien (v14, config incompatible), donc pip comme ansible-core ci-dessus ; bubblewrap
# fournit le sandboxing requis par un vrai `mkosi build`. Détection : apps/api/src/services/iac/engines.ts.
RUN pip3 install --no-cache-dir --break-system-packages mkosi \
    && apt-get update && apt-get install -y --no-install-recommends bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# OpenTofu : script d'installation officiel (gère l'architecture cible automatiquement).
RUN curl -fsSL https://get.opentofu.org/install-opentofu.sh -o /tmp/install-opentofu.sh \
    && chmod +x /tmp/install-opentofu.sh \
    && /tmp/install-opentofu.sh --install-method standalone \
    && rm -f /tmp/install-opentofu.sh

# Packer : binaire statique HashiCorp officiel (dépôt apt HashiCorp non ajouté pour rester
# minimal — un seul binaire à récupérer). Usage interne (mairie), pas de revente d'un service
# hébergé concurrent : la licence BUSL de Packer ne pose pas de problème dans ce contexte.
RUN PACKER_VERSION=1.11.2 \
    && ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "arm64"; else echo "amd64"; fi) \
    && curl -fsSL "https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_linux_${ARCH}.zip" -o /tmp/packer.zip \
    && unzip -q /tmp/packer.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/packer \
    && rm -f /tmp/packer.zip

# Grype : script d'installation officiel (gère l'architecture cible automatiquement), scanner
# de vulnérabilités CVE pour images de conteneurs — pilote le même principe que
# OpenTofu/Ansible/Packer ci-dessus (binaire réel en sous-processus, voir
# apps/api/src/services/scan.ts), aucune réimplémentation.
RUN curl -sSfL https://raw.githubusercontent.com/anchore/grype/main/install.sh | sh -s -- -b /usr/local/bin

# OSV-Scanner (https://github.com/google/osv-scanner, Apache-2.0) : scanner de vulnérabilités
# basé sur la base OSV.dev, en complément de Grype (voir apps/api/src/services/scan.ts) — les
# deux scanners coexistent, aucun ne remplace l'autre. Pas de script d'installation officiel
# (contrairement à OpenTofu/Grype ci-dessus) : binaire statique de release téléchargé
# directement, un seul fichier par architecture (pas d'archive à extraire).
RUN OSV_SCANNER_VERSION=v2.5.0 \
    && ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "arm64"; else echo "amd64"; fi) \
    && curl -fsSL "https://github.com/google/osv-scanner/releases/download/${OSV_SCANNER_VERSION}/osv-scanner_linux_${ARCH}" -o /usr/local/bin/osv-scanner \
    && chmod +x /usr/local/bin/osv-scanner

# Docker CLI (client uniquement, pas le daemon) : contrairement à Grype qui parle directement à
# l'API du démon Docker, `osv-scanner scan image` shelle vers la commande `docker` (pull/save)
# pour résoudre une image locale — constaté en testant le binaire ci-dessus (erreur "exec: docker:
# executable file not found in $PATH" sans ce paquet). Le socket Docker de l'hôte est déjà monté
# dans le conteneur dev (docker-compose.dev.yml) ; seul le client manquait. Binaire statique
# officiel Docker (archive contenant plusieurs binaires, seul `docker/docker` — le client — est
# conservé), même démarche que Packer/OSV-Scanner ci-dessus.
RUN DOCKER_CLI_VERSION=29.7.2 \
    && ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "aarch64"; else echo "x86_64"; fi) \
    && curl -fsSL "https://download.docker.com/linux/static/stable/${ARCH}/docker-${DOCKER_CLI_VERSION}.tgz" -o /tmp/docker-cli.tgz \
    && tar -xzf /tmp/docker-cli.tgz -C /tmp docker/docker \
    && mv /tmp/docker/docker /usr/local/bin/docker \
    && chmod +x /usr/local/bin/docker \
    && rm -rf /tmp/docker-cli.tgz /tmp/docker

# Docker Compose (plugin CLI officiel, https://github.com/docker/compose, Apache-2.0) : nécessaire
# pour piloter `docker compose` en sous-processus (déploiement automatique GitHub d'un dépôt dont
# le seul artefact est un docker-compose.yml — voir apps/api/src/services/github.ts#
# deployViaDockerCompose, spawn("docker", ["compose", ...])). Le client `docker` ci-dessus ne sait
# PAS lui-même parler "compose" (`docker compose` répond "unknown command" sans ce plugin,
# constaté en testant le binaire ci-dessus) : binaire statique officiel installé dans le
# répertoire standard des plugins CLI Docker, comme le préconise sa documentation d'installation
# manuelle — aucune réimplémentation de docker-compose.
RUN DOCKER_COMPOSE_VERSION=v2.29.7 \
    && ARCH=$(if [ "$TARGETARCH" = "arm64" ]; then echo "aarch64"; else echo "x86_64"; fi) \
    && mkdir -p /usr/local/lib/docker/cli-plugins \
    && curl -fsSL "https://github.com/docker/compose/releases/download/${DOCKER_COMPOSE_VERSION}/docker-compose-linux-${ARCH}" -o /usr/local/lib/docker/cli-plugins/docker-compose \
    && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

RUN corepack enable && corepack prepare pnpm@9.1.0 --activate

WORKDIR /workspace
