{
  "name": "@quai/api",
  "version": "0.1.0",
  "private": true,
  "description": "QUAI API — serveur Fastify pilotant Docker/Swarm, Kubernetes, registries d'images, GitOps et l'authentification LDAP.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build:contract": "tsc -p ../../packages/plugin-contract/tsconfig.json",
    "dev": "pnpm run build:contract && nodemon --legacy-watch --delay 1 --watch src --ext ts,json --exec tsx src/index.ts",
    "build": "pnpm run build:contract && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "pnpm run build:contract && vitest run",
    "test:watch": "pnpm run build:contract && vitest",
    "typecheck": "pnpm run build:contract && tsc -p tsconfig.json --noEmit",
    "lint": "pnpm run build:contract && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/websocket": "^10.0.1",
    "@kubernetes/client-node": "^0.21.0",
    "@quai/plugin-contract": "workspace:*",
    "@quai/wasm-core": "workspace:*",
    "dockerode": "^4.0.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "net-snmp": "^3.26.3",
    "nodemailer": "^6.9.14",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "simple-git": "^3.25.0",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/ldapjs": "^3.0.6",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^20.14.13",
    "@types/nodemailer": "^6.4.15",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
