# syntax=docker/dockerfile:1
#
# Image de production pour @quai/api (Fastify, TypeScript).
#
# Contexte de build : la RACINE DU MONOREPO (pas deploy/docker/), car pnpm
# workspace a besoin de voir apps/*, packages/* et les fichiers de workspace
# à la racine pour résoudre les dépendances internes (@quai/wasm-core).
#
# Construire depuis la racine du repo :
#   docker build -f deploy/docker/Dockerfile.api -t quai-api .
#
# ---------------------------------------------------------------------------
# Stage 1 : compilation du crate Rust packages/wasm-core en WebAssembly
# ---------------------------------------------------------------------------
FROM rust:1-slim AS rust-builder

# curl/ca-certificates/pkg-config nécessaires pour installer wasm-pack et
# compiler les éventuelles dépendances natives du crate.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

WORKDIR /workspace/packages/wasm-core

# On ne copie que le crate : ce stage n'a besoin de rien d'autre du monorepo.
COPY packages/wasm-core/ ./

# NOTE: --target nodejs car le binding généré est consommé côté serveur par
# @quai/api (Node.js), pas par un bundler navigateur. Si l'équipe wasm-core
# expose son propre script `pnpm build` (ex: `wasm-pack build --target ...`
# avec des flags différents), remplacer la ligne ci-dessous par cet appel
# pour rester la seule source de vérité sur les flags de build wasm-pack.
RUN wasm-pack build --release --target nodejs --out-dir pkg

# Résultat exploité par le stage suivant : /workspace/packages/wasm-core/pkg

# ---------------------------------------------------------------------------
# Stage 2 : install workspace pnpm + build TypeScript de @quai/api
# ---------------------------------------------------------------------------
FROM node:22-slim AS build

RUN corepack enable \
    && corepack prepare pnpm@9.1.0 --activate

WORKDIR /workspace

# Le workspace complet est nécessaire : pnpm doit voir tous les
# package.json (apps/*, packages/*) pour résoudre les dépendances internes
# du monorepo, même si seul @quai/api est construit ici.
COPY . .

# On remplace le contenu de packages/wasm-core/pkg (absent du dépôt, généré)
# par le binding compilé au stage précédent.
COPY --from=rust-builder /workspace/packages/wasm-core/pkg ./packages/wasm-core/pkg

RUN pnpm install --frozen-lockfile

# PAS de "..." ici : ça inclurait @quai/wasm-core dans le graphe de build de
# pnpm, qui ré-exécuterait alors SON PROPRE script "build" (package.json —
# `wasm-pack build --target bundler --out-dir pkg`) dans CE stage, qui n'a
# pas la toolchain Rust/wasm-pack (seul le stage rust-builder l'a) — pipeline
# CI cassé avec "wasm-pack: not found" jusqu'à ce correctif. Le binding wasm
# déjà compilé au bon target (nodejs) est copié depuis rust-builder ci-dessus ;
# @quai/api n'a besoin que de son propre `tsc`, pas d'un rebuild de wasm-core.
RUN pnpm --filter @quai/api build

# Bundle de déploiement autonome : ne garde que les deps de prod de
# @quai/api, avec les dépendances de workspace "dé-symlinkées" (fichiers
# réels), ce qui simplifie beaucoup le stage final ci-dessous.
RUN pnpm --filter @quai/api deploy --prod /workspace/out/api

# MODULES D'ORIGINE : les quatre intégrations livrées avec QUAI sont empaquetées et signées ICI,
# avec une paire de clés Ed25519 générée pour ce seul build. La clé privée n'est jamais écrite sur
# disque et disparaît avec ce processus ; seule la clé publique (origin-key.pub) part dans l'image
# finale. Conséquences : aucun secret à conserver, et personne ne peut fabriquer un paquet que cette
# image accepterait. Ce stage n'est PAS copié tel quel dans l'image finale — seul le répertoire de
# paquets ci-dessous l'est, donc aucune couche livrée n'a jamais contenu la clé privée.
# --host-root : chemin du code de l'application tel qu'il sera vu À L'EXÉCUTION (/app/dist),
# jamais celui du build. Le script échoue si un greffon ne se charge pas : mieux vaut un build rouge
# qu'une image dont une intégration serait silencieusement absente.
RUN node scripts/build-origin-plugins.mjs \
        --dist /workspace/out/api/dist \
        --host-root /app/dist \
        --out /workspace/origin-plugins

# ---------------------------------------------------------------------------
# Stage 3 : image finale minimale
# ---------------------------------------------------------------------------
FROM node:22-slim AS runtime

ENV NODE_ENV=production \
    PORT=3000

# DNS Active Directory (services/adDns.ts) : `kinit` (krb5-user) + `nsupdate -g` (dnsutils) sont
# de VRAIS binaires wrappés en sous-processus, jamais réimplémentés (même principe que les autres
# intégrations infra-as-code de ce projet). DEBIAN_FRONTEND=noninteractive évite que le paquet
# krb5-user ne bloque ce build sur sa question debconf "royaume Kerberos par défaut" — sans
# incidence, chaque appel fournit son propre krb5.conf temporaire (KRB5_CONFIG).
RUN DEBIAN_FRONTEND=noninteractive apt-get update && apt-get install -y --no-install-recommends \
        krb5-user \
        dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Autorités de certification INTERNES (AD CS de la collectivité, certificat auto-signé d'un
# service interne...). Sans elles, tout appel HTTPS vers un service interne échoue avant
# l'authentification — « fetch failed » côté GLPI, DEPTH_ZERO_SELF_SIGNED_CERT côté registry
# GitLab (constaté le 25/08/2026). Fourni en base64 pour traverser sans dommage les variables
# CI et le fichier d'environnement du compose ; vide = comportement inchangé. Le `grep` final fait
# échouer le build plutôt que de livrer une image qui ne ferait silencieusement confiance à rien.
ARG INTERNAL_CA_BUNDLE_B64=""
RUN mkdir -p /etc/ssl/quai \
    && if [ -n "$INTERNAL_CA_BUNDLE_B64" ]; then \
        echo "$INTERNAL_CA_BUNDLE_B64" | base64 -d > /etc/ssl/quai/internal-ca.pem \
        && chmod 644 /etc/ssl/quai/internal-ca.pem \
        && grep -q "BEGIN CERTIFICATE" /etc/ssl/quai/internal-ca.pem; \
    else \
        : > /etc/ssl/quai/internal-ca.pem; \
    fi
# Lu par Node en PLUS du magasin public : un bundle absent est simplement ignoré.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/quai/internal-ca.pem

WORKDIR /app

# node:22-slim fournit déjà un utilisateur non-root "node" (uid 1000) prêt
# à l'emploi — inutile d'en recréer un.
COPY --from=build --chown=node:node /workspace/out/api/ ./

# Paquets d'origine + clé publique d'origine. VOLONTAIREMENT laissés à root : l'API tourne sous
# "node" et ne doit pas pouvoir réécrire la clé qui décide de ce qu'elle accepte, ni les paquets
# qu'elle réinstalle. Ils sont seulement LUS, puis recopiés dans /app/data au premier démarrage
# (voir apps/api/src/plugins/origin.ts) — c'est cette copie, dans le volume de données, que l'admin
# peut désinstaller pour de bon.
COPY --from=build /workspace/origin-plugins/ /app/origin-plugins/
ENV PLUGIN_ORIGIN_PATH=/app/origin-plugins

# ./data/ (config.json/secrets.json/audit-log.jsonl/watchdog-state.json/...,
# CONFIG_PATH par défaut, voir config.ts) est créée ET possédée par "node"
# AVANT de perdre les privilèges root — sans ça, un premier démarrage réel
# échoue en EACCES sur mkdir('/app/data') (reproduit et vérifié en lançant
# l'image construite ici). Un volume nommé/anonyme monté sur /app/data
# hérite de ce contenu/ces permissions au premier montage (comportement
# standard de Docker), donc ça reste correct même avec un volume externe.
RUN mkdir -p /app/data && chown node:node /app/data

USER node

EXPOSE 3000

# NOTE pour l'agent backend : cette healthcheck suppose l'existence d'une
# route GET /health répondant 200 quand le service est opérationnel. Cette
# route n'est PAS implémentée ici — à exposer côté @quai/api (hors périmètre
# de ce Dockerfile).
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
